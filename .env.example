OPENAI_API_KEY=your_qwen_or_openai_key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus
# Optional: used once when the primary model returns HTTP 429.
OPENAI_FALLBACK_MODEL=qwen-plus

# Optional: per-request model timeout in seconds (default 180)
OPENAI_TIMEOUT_SECONDS=180

# Reasoning effort per role (defaults in code):
# main / requirements / research: low; planning / revision: medium;
# revision explain mode: low. No change to the selected model.
# Optional global override; "default" omits reasoning_effort and uses provider defaults.
# OPENAI_REASONING_EFFORT=default
# Optional role overrides take precedence over the global override.
# OPENAI_REASONING_EFFORT_MAIN=low
# OPENAI_REASONING_EFFORT_REQUIREMENTS=low
# OPENAI_REASONING_EFFORT_RESEARCH=low
# OPENAI_REASONING_EFFORT_PLANNING=medium
# OPENAI_REASONING_EFFORT_REVISION=medium
# Values: default, none, minimal, low, medium, high, xhigh, max.
# Supported values depend on your model/provider. Explicit rejection retries once
# without this parameter; HTTP success alone does not prove reasoning depth.

# SQLite snapshot persistence
TRAVEL_DB_PATH=.cache/travelassistant.sqlite3
TRAVEL_PERSISTENCE=1

# Set to 1 behind HTTPS if proxy headers do not expose the original scheme
TRAVEL_COOKIE_SECURE=0

# AMap (Gaode) Web Service key, used by the search_food tool (free individual quota)
AMAP_MAP_KEY=your_amap_web_service_key
