# Required: replace placeholders with your actual provider settings.
# Missing/blank/placeholder required settings stop startup before database creation.
OPENAI_API_KEY=your_openai_compatible_key
OPENAI_BASE_URL=
OPENAI_MODEL=your_model_name
# Optional: retry each failed primary HTTP 429 request on fallback at most once,
# not once per whole turn; shared budgets still apply. Blank disables fallback.
OPENAI_FALLBACK_MODEL=

# Required API protocol: chat_completions or responses; no implicit protocol.
OPENAI_WIRE_API=responses
# Required explicit privacy policy: true or false; false disables provider storage.
OPENAI_STORE_RESPONSES=false

# Required: finite positive per-request model timeout in seconds.
OPENAI_TIMEOUT_SECONDS=240

# Single business agent default: medium; independent HTML display default: low.
# No change to the selected model. No child business-agent reasoning settings.
# Optional global override; "default" omits reasoning_effort and uses provider defaults.
# OPENAI_REASONING_EFFORT=default
# Optional role overrides take precedence over the global override.
# OPENAI_REASONING_EFFORT_TRAVEL_AGENT=medium
# OPENAI_REASONING_EFFORT_MAIN=medium  # compatibility alias
# OPENAI_REASONING_EFFORT_DISPLAY=low
# Main thinking uses provider defaults unless explicitly overridden.
# chat_completions only: sends chat_template_kwargs.enable_thinking for travel_agent;
# responses does not send this switch.
# OPENAI_MAIN_ENABLE_THINKING=false  # optional provider-specific explicit override
# Values: default, none, minimal, low, medium, high, xhigh, max.
# Supported values depend on your model/provider. All fixed model parameters
# (reasoning, tools, response_format) fail explicitly when rejected; the application
# never silently removes/replaces them or retries with a downgraded response format.

# Required switch; timeout is required only when HTML generation is enabled.
TRAVEL_DISPLAY_ENABLED=1
TRAVEL_DISPLAY_TIMEOUT_SECONDS=180

# Required database path and persistence policy (examples, not code fallbacks).
# travel-full continues to use TRAVEL_DB_PATH=.cache/travelassistant.sqlite3.
CITY_DB_PATH=.cache/cityassistant.sqlite3
TRAVEL_PERSISTENCE=1

# Required explicit cookie policy: set 1 for HTTPS deployments, 0 for local HTTP.
TRAVEL_COOKIE_SECURE=0

# AMap: search/routes via official MCP; POI details via HTTPS REST v3 (extensions=all).
# The same server-side Web Service key needs permission/quota for both APIs.
# Existing AMAP_MAP_KEY remains compatible; AMAP_MAPS_API_KEY takes precedence.
AMAP_MAP_KEY=your_amap_web_service_key
AMAP_MAPS_API_KEY=
AMAP_MCP_URL=https://mcp.amap.com/mcp
# MCP connection/discovery/search/routes share this budget; lodging search +
# at most five distinct REST detail attempts also share this monotonic deadline.
AMAP_MCP_TIMEOUT_SECONDS=20
# Optional REST per-phase HTTP timeout; omitted defaults to 10 seconds.
# If supplied it must be finite, positive and <=120 seconds (blank is invalid).
# Limited by remaining budget/deadline; synchronous in-flight I/O is not instantly
# cancellable or a strict wall-clock timeout. No redirects, retries or fallback.
AMAP_REST_TIMEOUT_SECONDS=10
