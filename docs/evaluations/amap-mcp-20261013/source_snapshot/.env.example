OPENAI_API_KEY=your_openai_compatible_key
OPENAI_BASE_URL=https://mirror.xinshu.ai/v1
OPENAI_MODEL=gpt-5.6-sol
# Optional: used once when the primary model returns HTTP 429; blank disables fallback.
OPENAI_FALLBACK_MODEL=

# API protocol: chat_completions (code default) or responses
OPENAI_WIRE_API=responses
# Provider-side response storage is disabled by default for both protocols.
OPENAI_STORE_RESPONSES=false

# Optional: per-request model timeout in seconds (default 180)
OPENAI_TIMEOUT_SECONDS=180

# Reasoning effort per role (defaults in code):
# main (intent) / chat / research / display: low; planning / revision: medium;
# revision explain mode: low. No change to the selected model.
# Optional global override; "default" omits reasoning_effort and uses provider defaults.
# OPENAI_REASONING_EFFORT=default
# Optional role overrides take precedence over the global override.
# OPENAI_REASONING_EFFORT_MAIN=low
# OPENAI_REASONING_EFFORT_CHAT=low
# OPENAI_REASONING_EFFORT_DISPLAY=low
# OPENAI_REASONING_EFFORT_RESEARCH=low
# OPENAI_REASONING_EFFORT_PLANNING=medium
# OPENAI_REASONING_EFFORT_REVISION=medium
# Values: default, none, minimal, low, medium, high, xhigh, max.
# Supported values depend on your model/provider. Explicit rejection retries once
# without this parameter; HTTP success alone does not prove reasoning depth.

# Background display conversion; prose is saved before this independent job.
TRAVEL_DISPLAY_ENABLED=1
TRAVEL_DISPLAY_TIMEOUT_SECONDS=180

# SQLite snapshot persistence
TRAVEL_DB_PATH=.cache/travelassistant.sqlite3
TRAVEL_PERSISTENCE=1

# Set to 1 behind HTTPS if proxy headers do not expose the original scheme
TRAVEL_COOKIE_SECURE=0

# AMap official MCP via Streamable HTTP (POI, restaurant details and routes).
# Existing AMAP_MAP_KEY remains compatible; AMAP_MAPS_API_KEY takes precedence.
AMAP_MAP_KEY=your_amap_web_service_key
AMAP_MAPS_API_KEY=
AMAP_MCP_URL=https://mcp.amap.com/mcp
# Per app tool: connection + discovery + up to 6 MCP calls share this wall budget.
AMAP_MCP_TIMEOUT_SECONDS=20
