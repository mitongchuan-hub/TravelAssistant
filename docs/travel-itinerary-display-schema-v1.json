{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:travelassistant:itinerary-display:1.0-draft",
  "title": "TravelAssistant 行程展示 JSON v1（讨论稿）",
  "description": "无工具 LLM 从对应版本的完整文字行程提取展示数据。原文未明确的信息为 null；未知、估算和待核实措辞须保留。版本、需求、证据和可信地点标识由程序提供。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "overview", "budget_note", "days", "preparation", "pending_items", "risks"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "展示协议版本，与具体行程版本分别管理。"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "原文的行程标题。"
    },
    "overview": {
      "$ref": "#/$defs/nullable_text",
      "description": "原文中的整体安排说明；没有则为 null。"
    },
    "budget_note": {
      "$ref": "#/$defs/nullable_text",
      "description": "原文的预算安排说明，保留总额/人均、费用范围、估算或分配上限等口径。"
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/day"},
      "description": "按原文顺序排列的旅行日。"
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clothing", "accommodation"],
      "properties": {
        "clothing": {
          "type": "array",
          "items": {"$ref": "#/$defs/preparation_item"},
          "description": "原文中的衣物与装备建议。"
        },
        "accommodation": {
          "type": "array",
          "items": {"$ref": "#/$defs/preparation_item"},
          "description": "原文中的住宿安排，保留建议、待确认等措辞。"
        }
      }
    },
    "pending_items": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "description": "原文明示的待确认事项。"
    },
    "risks": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "description": "原文中的出行提醒与风险，不新增推测。"
    }
  },
  "$defs": {
    "nullable_text": {
      "type": ["string", "null"],
      "minLength": 1,
      "description": "原文未明确的信息使用 null；不使用空字符串或猜测值。"
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "label", "theme", "items"],
      "properties": {
        "date": {
          "type": ["string", "null"],
          "format": "date",
          "description": "原文明确的 YYYY-MM-DD 日期；无法明确年月日时为 null。仅第N天的日期由程序依据对应版本的日期窗口映射。"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "当天标签，例如第1天；按原文顺序保持一致。"
        },
        "theme": {
          "$ref": "#/$defs/nullable_text",
          "description": "原文明示的当天主题，没有则为 null。"
        },
        "items": {
          "type": "array",
          "items": {"$ref": "#/$defs/item"},
          "description": "按原文顺序排列的活动卡片；没有明确安排时可为空数组。"
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time_text", "title", "category", "location", "duration_text", "description", "cost_text", "notes"],
      "properties": {
        "time_text": {
          "$ref": "#/$defs/nullable_text",
          "description": "保留原文时间表达，如14:00–15:00、午后、抵达后；不把模糊时间补成具体时刻。"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "原文的活动或安排名称。"
        },
        "category": {
          "type": "string",
          "enum": ["activity", "meal", "transport", "accommodation", "rest", "other"],
          "description": "活动、用餐、交通、住宿、休息或其他；无法明确归类时为 other。仅影响卡片样式。"
        },
        "location": {
          "$ref": "#/$defs/nullable_text",
          "description": "原文地点或区域文字；不生成地址、坐标或 POI ID。"
        },
        "duration_text": {
          "$ref": "#/$defs/nullable_text",
          "description": "原文明示的时长及估算措辞；不能根据时段擅自认定交通耗时。"
        },
        "description": {
          "$ref": "#/$defs/nullable_text",
          "description": "原文的安排说明，包括路线、交通方式、推荐菜或活动说明。"
        },
        "cost_text": {
          "$ref": "#/$defs/nullable_text",
          "description": "原文费用说明，保留预算预留、估算、价格待核实等口径；不是自动核实的报价。"
        },
        "notes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "description": "原文中的预约、开放、饮食、缓冲等备注；没有则为 []。"
        }
      }
    },
    "preparation_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "body": {
          "$ref": "#/$defs/nullable_text",
          "description": "原文准备事项说明，保留建议与未知状态。"
        }
      }
    }
  }
}
